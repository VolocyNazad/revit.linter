<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- The pane state is Revit-free; the file is compiled here so the test never loads the repacked add-in. -->
		<Compile Include="..\..\src\Revit.Linter\Infrastructure\Services\DiagnosticPanesState.cs" Link="DiagnosticPanesState.cs" />
	</ItemGroup>

</Project>
