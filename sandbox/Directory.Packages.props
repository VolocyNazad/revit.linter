<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI" Version="$(MajorRevitVersion).*" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(MajorRevitVersion).*" />
    <PackageVersion Include="ModularPipelines" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.DotNet" Version="3.2.8" />
    <PackageVersion Include="ModularPipelines.Git" Version="3.2.8" />
  </ItemGroup>
</Project>
