<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Platforms>x64;Any CPU</Platforms>
    <Configurations>
      Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
      Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0;
    </Configurations>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PolySharpExcludeGeneratedTypes>System.Index;System.Range</PolySharpExcludeGeneratedTypes>
    <WarningsAsErrors Condition="'$(EnforcePublicApiDocumentation)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
</Project>
