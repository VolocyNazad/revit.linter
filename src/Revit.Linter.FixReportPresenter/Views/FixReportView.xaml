<UserControl
    x:Class="Revit.Linter.FixReportPresenter.Views.FixReportView"
    behaviors:HelpToolTip.HelpCommand="{Binding OpenHelpCommand}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.FixReportPresenter.DesignData"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:Revit.Linter.ThemeManaging.Controls;assembly=Revit.Linter.ThemeManaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:composition="clr-namespace:Revit.Linter.Presentation;assembly=Revit.Linter.Presentation"
    xmlns:runDiagnostic="clr-namespace:Revit.Linter.RunDiagnosticPresenter.ViewModels;assembly=Revit.Linter.RunDiagnosticPresenter"
    xmlns:messaging="clr-namespace:Revit.Linter.ReportMessaging;assembly=Revit.Linter.ReportMessaging"
    d:DataContext="{d:DesignInstance Type={x:Type designData:FixReportDesignData}, IsDesignTimeCreatable=True}"
    d:DesignHeight="400"
    d:DesignWidth="2000"
    Style="{DynamicResource LinterViewRoot}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <composition:BindingProxy x:Key="rootProxy" DataContext="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Style="{StaticResource LinterViewPanel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource LinterToolBarPanel}">
                <ContentControl Content="{composition:ViewLocatorExtension {x:Type runDiagnostic:RunDiagnosticViewModel}}" />
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource LinterToolBarContextLabel}"
                    Text="{Binding SelectedItem.DisplayName, ElementName=DocumentFilterList}"
                    ToolTip="{Binding SelectedItem.DisplayName, ElementName=DocumentFilterList}" />
                <Button
                    behaviors:HelpToolTip.Description="{Binding OpenHelpDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding OpenHelpText, Mode=OneWay}"
                    Command="{Binding OpenHelpCommand}"
                    Content="{controls:Icon Kind=HelpCircleOutline}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarIconButton}" />
                <ToggleButton
                    x:Name="FiltersButton"
                    behaviors:HelpToolTip.Description="{Binding MoreFiltersDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding MoreFiltersTitle, Mode=OneWay}"
                    Content="{controls:Icon Kind=Filter}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarPopupToggleButton}" />
                <Popup
                    IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=FiltersButton}"
                    Style="{StaticResource LinterToolBarPopup}">
                    <Border Style="{StaticResource LinterPopupPanel}">
                        <ListBox
                            x:Name="DocumentFilterList"
                            behaviors:HelpToolTip.Description="{Binding DocumentDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding DocumentText, Mode=OneWay}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding DataContext.OpenedDocuments.Documents, Source={StaticResource rootProxy}}"
                            SelectedValue="{Binding TargetDocumentTitle}"
                            SelectedValuePath="Title"
                            Style="{StaticResource LinterRadioListBox}" />
                    </Border>
                </Popup>
                <TextBox
                    behaviors:HelpToolTip.Description="{Binding SearchDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding SearchText, Mode=OneWay}"
                    controls:Hint.Text="{Binding SearchText}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterSearchTextBox}"
                    Text="{Binding SearchField, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarLabel}"
                    Text="{Binding FixesText}" />
                <UIElement />
            </DockPanel>
            <Rectangle DockPanel.Dock="Top" Style="{StaticResource LinterHorizontalDivider}" />
            <DataGrid
                x:Name="FixesGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding CollectionViewSource.View}"
                SelectedItem="{Binding SelectedFixReport, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <behaviors:FirstMatchRowHighlightBehavior HighlightKey="FixList" TargetCode="TOUR001" />
                </i:Interaction.Behaviors>
                <DataGrid.Resources>
                    <composition:BindingProxy x:Key="proxy" DataContext="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridCodeColumnMinWidth}"
                        Header="{Binding DataContext.CodeHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterReadOnlyCellTextBox}" Text="{Binding Code}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="{StaticResource LinterStretchColumnMinWidth}"
                        Header="{Binding DataContext.MessageHeader, Source={StaticResource proxy}}"
                        SortMemberPath="MessageText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <Style BasedOn="{StaticResource LinterReportHyperlink}" TargetType="Hyperlink" />
                                </DataTemplate.Resources>
                                <messaging:ReportMessageView
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsSelectionEnabled="True"
                                    LinkCommand="{Binding AccentElementCommand}"
                                    Parts="{Binding MessageParts}"
                                    ToolTipFormat="{Binding ShowElementToolTipFormat}"
                                    VerticalAlignment="Center"
                                    VerticalScrollBarVisibility="Disabled">
                                    <i:Interaction.Behaviors>
                                        <behaviors:PassMouseWheelToParentBehavior />
                                    </i:Interaction.Behaviors>
                                </messaging:ReportMessageView>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridDocumentColumnMinWidth}"
                        Header="{Binding DataContext.DocumentHeader, Source={StaticResource proxy}}"
                        SortMemberPath="DocumentTitle">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterReadOnlyCellTextBox}" Text="{Binding DocumentTitle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridCreatedColumnMinWidth}"
                        Header="{Binding DataContext.CreatedHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Created">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterReadOnlyCellTextBox}" Text="{Binding CreatedText, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
