<UserControl
    x:Class="Revit.Linter.FixReportPresenter.Views.FixReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:infrastructure="clr-namespace:Revit.Linter.FixReportPresenter.Infrastructure"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Revit.Linter.FixReportPresenter.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:FixReportViewModel}}"
    d:DesignHeight="400"
    d:DesignWidth="2000"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Cyan"
                    SecondaryColor="DeepOrange" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <viewModels:ServiceLocator x:Key="ServiceLocator" />
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <materialDesign:ColorZone
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <DockPanel>
            <DockPanel Height="45" DockPanel.Dock="Top">
                <ContentControl Content="{Binding RunDiagnosticView, Source={StaticResource ServiceLocator}}" />
                <ComboBox
                    MinWidth="150"
                    Margin="5"
                    materialDesign:HintAssist.Hint="{Binding DocumentText}"
                    materialDesign:HintAssist.IsFloating="True"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding OpenedDocumentsViewModel.Collection, Source={StaticResource ServiceLocator}}"
                    SelectedValue="{Binding TargetDocumentTitle}"
                    SelectedValuePath="Title"
                    Style="{StaticResource MaterialDesignComboBox}" />
                <Button
                    Content="{materialDesign:PackIcon Kind=FilterPlus,
                                                      Size=20}"
                    DockPanel.Dock="Right"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignIconButton}" />
                <TextBox
                    Width="200"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="{Binding SearchText}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Search"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding SearchField, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Text="{Binding FixesText}" />
                <UIElement />
            </DockPanel>
            <Rectangle
                Height="1"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Top"
                Fill="{DynamicResource MaterialDesignDivider}" />
            <DataGrid
                d:ItemsSource="{d:SampleData ItemCount=2}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding CollectionViewSource.View}">
                <DataGrid.Resources>
                    <infrastructure:BindingProxy x:Key="proxy" DataContext="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{Binding DataContext.CodeHeader, Source={StaticResource proxy}}" SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    IsReadOnlyCaretVisible="False"
                                    Style="{StaticResource MaterialDesignTextBox}"
                                    Text="{Binding Code}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding DataContext.MessageHeader, Source={StaticResource proxy}}" SortMemberPath="Message">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <FlowDocumentScrollViewer
                                    Width="1800"
                                    Document="{Binding Message}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsSelectionEnabled="True"
                                    VerticalScrollBarVisibility="Disabled">
                                    <i:Interaction.Behaviors>
                                        <behaviors:PassMouseWheelToParentBehavior />
                                    </i:Interaction.Behaviors>
                                </FlowDocumentScrollViewer>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding DataContext.DocumentHeader, Source={StaticResource proxy}}" SortMemberPath="DocumentTitle">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    IsReadOnlyCaretVisible="False"
                                    Style="{StaticResource MaterialDesignTextBox}"
                                    Text="{Binding DocumentTitle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding DataContext.CreatedHeader, Source={StaticResource proxy}}" SortMemberPath="Created">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    IsReadOnlyCaretVisible="False"
                                    Style="{StaticResource MaterialDesignTextBox}"
                                    Text="{Binding CreatedText, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </materialDesign:ColorZone>
</UserControl>
