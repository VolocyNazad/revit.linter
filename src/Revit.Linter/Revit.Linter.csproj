<Project Sdk="VolocyNazad.Revit.Sdk/1.0.43">

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Authors>VolocyNazad</Authors>
	</PropertyGroup>
	<PropertyGroup>
		<LaunchRevit>true</LaunchRevit>
		<GenerateAddinOnBuild>true</GenerateAddinOnBuild>
		<IsRepackable>true</IsRepackable>
		<RepackBinariesExcludes>MaterialDesignThemes.Wpf.dll;MaterialDesignColors.dll;Microsoft.Xaml.Behaviors.dll;Revit.Linter.Localization.dll</RepackBinariesExcludes>
		<StartArguments>/language RUS</StartArguments>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="required-revit-project-parameters.txt" />
	</ItemGroup>
	<ItemGroup>
		<ExternalApplication Include="Revit.Linter">
			<FullClassName>Revit.Linter.InitExternalApplication</FullClassName>
			<Name>Revit.Linter</Name>
		</ExternalApplication>
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
			<CopyToOutputDirectory Condition="$(Configuration.Contains('Debug'))">PreserveNewest</CopyToOutputDirectory>
			<CopyToOutputDirectory Condition="!$(Configuration.Contains('Debug'))">Never</CopyToOutputDirectory>
			<DependentUpon>appsettings.json</DependentUpon>
		</Content>
		<Content Include="appsettings.Production.json" Condition="Exists('appsettings.Production.json')">
			<CopyToOutputDirectory Condition="$(Configuration.Contains('Release'))">PreserveNewest</CopyToOutputDirectory>
			<CopyToOutputDirectory Condition="!$(Configuration.Contains('Release'))">Never</CopyToOutputDirectory>
			<DependentUpon>appsettings.json</DependentUpon>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="required-revit-project-parameters.txt">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Resources\None Icon.tiff">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="Revit_All_Main_Versions_API_x64" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Extensions.Hosting" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.Debug" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="VolocyNazad.AssemblyResolver" />
		<PackageReference Include="VolocyNazad.Revit.Events" />
		<PackageReference Include="ILRepack" PrivateAssets="all" IncludeAssets="build" />
		<PackageReference Include="VolocyNazad.Revit.Async" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Revit.Linter.CollisionDiagnostics\Revit.Linter.CollisionDiagnostics.csproj" />
		<ProjectReference Include="..\Revit.Linter.ConfigurationPath\Revit.Linter.ConfigurationPath.csproj" />
		<ProjectReference Include="..\Revit.Linter.Core\Revit.Linter.Core.csproj" />
		<ProjectReference Include="..\Revit.Linter.DiagnosticListPresenter\Revit.Linter.DiagnosticListPresenter.csproj" />
		<ProjectReference Include="..\Revit.Linter.DiagnosticReportPresenter\Revit.Linter.DiagnosticReportPresenter.csproj" />
		<ProjectReference Include="..\Revit.Linter.DiagnosticReportProvider\Revit.Linter.DiagnosticReportProvider.csproj" />
		<ProjectReference Include="..\Revit.Linter.Diagnostic\Revit.Linter.Diagnostic.csproj" />
		<ProjectReference Include="..\Revit.Linter.DialogPresenter\Revit.Linter.DialogPresenter.csproj" />
		<ProjectReference Include="..\Revit.Linter.DocumentDiagnostics\Revit.Linter.DocumentDiagnostics.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementAccentor\Revit.Linter.ElementAccentor.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementChangesProvider\Revit.Linter.ElementChangesProvider.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementChangesMonitor\Revit.Linter.ElementChangesMonitor.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementDiagnostics\Revit.Linter.ElementDiagnostics.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementDependencyDefiners\Revit.Linter.ElementDependencyDefiners.csproj" />
		<ProjectReference Include="..\Revit.Linter.ElementIgnoring\Revit.Linter.ElementIgnoring.csproj" />
		<ProjectReference Include="..\Revit.Linter.FixReportPresenter\Revit.Linter.FixReportPresenter.csproj" />
		<ProjectReference Include="..\Revit.Linter.FixReportProvider\Revit.Linter.FixReportProvider.csproj" />
		<ProjectReference Include="..\Revit.Linter.Localization\Revit.Linter.Localization.csproj" />
		<ProjectReference Include="..\Revit.Linter.OpenedDocuments\Revit.Linter.OpenedDocuments.csproj" />
		<ProjectReference Include="..\Revit.Linter.ParameterElementDiagnostics\Revit.Linter.ParameterElementDiagnostics.csproj" />
		<ProjectReference Include="..\Revit.Linter.ProjectParameterManaging\Revit.Linter.ProjectParameterManaging.csproj" />
		<ProjectReference Include="..\Revit.Linter.SerilogEnrichers\Revit.Linter.SerilogEnrichers.csproj" />
		<ProjectReference Include="..\Revit.Linter.ThemeManaging\Revit.Linter.ThemeManaging.csproj" />
		<ProjectReference Include="..\Revit.Linter.UserDiagnostics\Revit.Linter.UserDiagnostics.csproj" />
		<ProjectReference Include="..\Toolkit.Revit.Extensions\Toolkit.Revit.Extensions.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\GlobalLocalizations.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>GlobalLocalizations.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\GlobalLocalizations.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>GlobalLocalizations.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
