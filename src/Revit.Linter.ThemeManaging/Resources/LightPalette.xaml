<ResourceDictionary
    x:Class="Revit.Linter.ThemeManaging.Resources.LightPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <!--
        Colors of the light theme, taken from the Revit interface with a color picker. The other palette declares
        the same keys; keep the two files in step. Styles refer to the Linter* brushes through DynamicResource.
    -->

    <!--  Content of a pane or a window, as in the project browser.  -->
    <SolidColorBrush x:Key="LinterBackgroundBrush" Color="#FFFFFF" />
    <!--  Tool bar and table header, as the group rows of the project browser.  -->
    <SolidColorBrush x:Key="LinterSurfaceBrush" Color="#F2F2F2" />
    <!--  Inside of input fields, check boxes and radio buttons.  -->
    <SolidColorBrush x:Key="LinterInputBackgroundBrush" Color="#FFFFFF" />
    <!--  Text and neutral icons.  -->
    <SolidColorBrush x:Key="LinterForegroundBrush" Color="#3C3C3C" />
    <!--  Hints and other text of lower importance.  -->
    <SolidColorBrush x:Key="LinterSecondaryForegroundBrush" Color="#808080" />
    <!--  Dividers and table lines.  -->
    <SolidColorBrush x:Key="LinterBorderBrush" Color="#E2E2E2" />
    <!--  Outlines of input fields, check boxes and popups.  -->
    <SolidColorBrush x:Key="LinterStrongBorderBrush" Color="#C1C1C1" />
    <!--  Row or item under the pointer.  -->
    <SolidColorBrush x:Key="LinterHoverBrush" Color="#E5F2F9" />
    <!--  Selected row and pressed button, as the pressed ribbon button.  -->
    <SolidColorBrush x:Key="LinterSelectionBrush" Color="#B6DFF1" />
    <!--  Links, accent icons and checked marks.  -->
    <SolidColorBrush x:Key="LinterAccentBrush" Color="#2B7BB3" />
    <!--  Accent under the pointer.  -->
    <SolidColorBrush x:Key="LinterAccentHoverBrush" Color="#1F5F8C" />
    <!--  Text and marks drawn on the accent color.  -->
    <SolidColorBrush x:Key="LinterAccentForegroundBrush" Color="#FFFFFF" />
    <!--  Icon that draws attention, such as the fix button.  -->
    <SolidColorBrush x:Key="LinterHighlightIconBrush" Color="#F0A030" />
    <!--  Text of a warning; dark enough to read as small text.  -->
    <SolidColorBrush x:Key="LinterSeverityWarningBrush" Color="#B8690F" />
    <!--  Text of an error.  -->
    <SolidColorBrush x:Key="LinterSeverityErrorBrush" Color="#D32F2F" />
    <!--  Track of a scroll bar.  -->
    <SolidColorBrush x:Key="LinterScrollBarTrackBrush" Color="#E9E9E9" />
    <!--  Thumb of a scroll bar.  -->
    <SolidColorBrush x:Key="LinterScrollBarThumbBrush" Color="#8D8D8D" />
    <!--  Thumb of a scroll bar under the pointer or dragged.  -->
    <SolidColorBrush x:Key="LinterScrollBarThumbHoverBrush" Color="#6E6E6E" />
    <!--  Chevrons of a scroll bar.  -->
    <SolidColorBrush x:Key="LinterScrollBarArrowBrush" Color="#808080" />
</ResourceDictionary>
