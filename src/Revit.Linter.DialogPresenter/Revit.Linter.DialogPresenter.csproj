<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">
	<PropertyGroup>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="VolocyNazad.MVVM.DependencyInjection" />
		<PackageReference Include="XamlConstructor">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="VolocyNazad.Revit.Context" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Remove="ViewModels\DialogViewModel*.resx" />
		<None Include="ViewModels\DialogViewModel.resx"><DependentUpon>DialogViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\DialogViewModel.ru.resx"><DependentUpon>DialogViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\DialogViewModel.resx" />
		<EmbeddedResource Remove="ViewModels\ConfirmationDialogViewModel*.resx" />
		<None Include="ViewModels\ConfirmationDialogViewModel.resx"><DependentUpon>ConfirmationDialogViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\ConfirmationDialogViewModel.ru.resx"><DependentUpon>ConfirmationDialogViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\ConfirmationDialogViewModel.resx" />
		<ProjectReference Include="..\Revit.Linter.Localization.Generator\Revit.Linter.Localization.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Revit.Linter.ThemeManaging\Revit.Linter.ThemeManaging.csproj" />
		<ProjectReference Include="..\Revit.Linter.Behaviors\Revit.Linter.Behaviors.csproj" />
		<ProjectReference Include="..\Revit.Linter.Localization\Revit.Linter.Localization.csproj" />
	</ItemGroup>

</Project>

