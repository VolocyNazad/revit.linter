<Window
    x:Class="Revit.Linter.DialogPresenter.Views.UpdateAvailableDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.DialogPresenter.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Width="500"
    MinWidth="400"
    MinHeight="175"
    MaxWidth="500"
    MaxHeight="500"
    d:DataContext="{d:DesignInstance Type={x:Type designData:UpdateAvailableDialogDesignData}, IsDesignTimeCreatable=True}"
    FocusManager.FocusedElement="{Binding ElementName=UpdateButton}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{DynamicResource LinterViewRoot}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type system:String}">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <i:Interaction.Behaviors>
        <behaviors:WindowDialogResultBehavior DialogResult="{Binding DialogResult}" />
    </i:Interaction.Behaviors>
    <Border Style="{StaticResource LinterWindowPanel}">
        <Grid Style="{StaticResource LinterDialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    d:Content="A new version of Revit Linter is available: 3.2.0. Open the GitHub release page to download and install it."
                    Content="{Binding Content}" />
            </ScrollViewer>
            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    d:Content="Close"
                    Content="{Binding CloseButtonText}"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    Style="{StaticResource LinterDialogButton}" />
                <Button
                    Margin="8,0,0,0"
                    d:Content="Skip this update"
                    Content="{Binding SkipButtonText}"
                    Command="{Binding SkipVersionCommand}"
                    Style="{StaticResource LinterDialogButton}" />
                <Button
                    x:Name="UpdateButton"
                    Margin="8,0,0,0"
                    d:Content="Update"
                    Content="{Binding UpdateButtonText}"
                    Command="{Binding OpenReleaseCommand}"
                    IsDefault="True"
                    Style="{StaticResource LinterDialogButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
