<Window
    x:Class="Revit.Linter.DialogPresenter.Views.ConfirmationDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:viewModels="clr-namespace:Revit.Linter.DialogPresenter.ViewModels"
    Width="500"
    MinWidth="250"
    MinHeight="175"
    MaxWidth="500"
    MaxHeight="500"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:ConfirmationDialogViewModel}}"
    FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{DynamicResource LinterViewRoot}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type system:String}">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <i:Interaction.Behaviors>
        <behaviors:WindowDialogResultBehavior DialogResult="{Binding DialogResult}" />
    </i:Interaction.Behaviors>
    <Border Style="{StaticResource LinterWindowPanel}">
        <Grid Style="{StaticResource LinterDialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    d:Content="Apply the selected fixes to 12 elements? This operation changes the current Revit document."
                    Content="{Binding Content}" />
            </ScrollViewer>
            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    d:Content="Close"
                    Content="{Binding CloseButtonText}"
                    Command="{Binding CloseWithResultCommand}"
                    IsCancel="True"
                    Style="{StaticResource LinterDialogButton}">
                    <Button.CommandParameter>
                        <system:Boolean>False</system:Boolean>
                    </Button.CommandParameter>
                </Button>
                <Button
                    x:Name="ConfirmButton"
                    Margin="8,0,0,0"
                    d:Content="Retry"
                    Content="{Binding ConfirmButtonText}"
                    Command="{Binding CloseWithResultCommand}"
                    IsDefault="True"
                    Style="{StaticResource LinterDialogButton}">
                    <Button.CommandParameter>
                        <system:Boolean>True</system:Boolean>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
