<UserControl
    x:Class="Revit.Linter.DiagnosticReportPresenter.Views.DiagnosticReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:composition="clr-namespace:Revit.Linter.Presentation;assembly=Revit.Linter.Presentation"
    xmlns:models="clr-namespace:Revit.Linter.Presentation.Models;assembly=Revit.Linter.Presentation"
    xmlns:controls="clr-namespace:Revit.Linter.ThemeManaging.Controls;assembly=Revit.Linter.ThemeManaging"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.DiagnosticReportPresenter.DesignData"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:messaging="clr-namespace:Revit.Linter.ReportMessaging;assembly=Revit.Linter.ReportMessaging"
    xmlns:runDiagnostic="clr-namespace:Revit.Linter.RunDiagnosticPresenter.ViewModels;assembly=Revit.Linter.RunDiagnosticPresenter"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    behaviors:HelpToolTip.HelpCommand="{Binding OpenHelpCommand}"
    d:DataContext="{d:DesignInstance Type={x:Type designData:DiagnosticReportDesignData}, IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="1400"
    Style="{DynamicResource LinterViewRoot}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <composition:BindingProxy x:Key="rootProxy" DataContext="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Style="{StaticResource LinterViewPanel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource LinterToolBarPanel}">
                <ContentControl Content="{composition:ViewLocatorExtension {x:Type runDiagnostic:RunDiagnosticViewModel}}" />
                <Rectangle DockPanel.Dock="Left" Style="{StaticResource LinterVerticalDivider}" />
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource LinterToolBarContextLabel}"
                    Text="{Binding SelectedItem.DisplayName, ElementName=DocumentFilterList}"
                    ToolTip="{Binding SelectedItem.DisplayName, ElementName=DocumentFilterList}" />
                <Rectangle DockPanel.Dock="Left" Style="{StaticResource LinterVerticalDivider}" />
                <Button
                    behaviors:HelpToolTip.Description="{Binding ShowPreviousDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding ShowPreviousText, Mode=OneWay}"
                    behaviors:OnboardingHighlight.Key="NavigateFindings"
                    Command="{Binding ShowPreviousVisualizationCommand}"
                    Content="{controls:Icon Kind=ChevronUp}"
                    DockPanel.Dock="Left"
                    Style="{StaticResource LinterToolBarIconButton}" />
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource LinterToolBarCounterLabel}"
                    Text="{Binding NavigationPositionText}" />
                <Button
                    behaviors:HelpToolTip.Description="{Binding ShowNextDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding ShowNextText, Mode=OneWay}"
                    behaviors:OnboardingHighlight.Key="NavigateFindings"
                    Command="{Binding ShowNextVisualizationCommand}"
                    Content="{controls:Icon Kind=ChevronDown}"
                    DockPanel.Dock="Left"
                    Style="{StaticResource LinterToolBarIconButton}" />
                <Button
                    behaviors:HelpToolTip.Description="{Binding OpenHelpDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding OpenHelpText, Mode=OneWay}"
                    Command="{Binding OpenHelpCommand}"
                    Content="{controls:Icon Kind=HelpCircleOutline}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarIconButton}" />
                <Button
                    behaviors:HelpToolTip.Description="{Binding ExportReportDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding ExportReportText, Mode=OneWay}"
                    behaviors:OnboardingHighlight.Key="ExportReport"
                    Command="{Binding ExportCommand}"
                    Content="{controls:Icon Kind=Export}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarIconButton}" />
                <ToggleButton
                    x:Name="HeatmapButton"
                    behaviors:HelpToolTip.Description="{Binding HeatmapDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding HeatmapText, Mode=OneWay}"
                    Command="{Binding ToggleHeatmapCommand}"
                    Content="{controls:Icon Kind=HeatMap}"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding IsHeatmapActive, Mode=TwoWay}"
                    Style="{StaticResource LinterToolBarOptionToggleButton}" />
                <ToggleButton
                    x:Name="ColumnsButton"
                    behaviors:HelpToolTip.Description="{Binding ColumnsDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding ColumnsTitle, Mode=OneWay}"
                    Content="{controls:Icon Kind=ViewColumnOutline}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarPopupToggleButton}" />
                <Popup
                    IsOpen="{Binding IsChecked, ElementName=ColumnsButton, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=ColumnsButton}"
                    Style="{StaticResource LinterToolBarPopup}">
                    <Border Style="{StaticResource LinterPopupPanel}">
                        <StackPanel>
                            <ItemsControl ItemTemplate="{StaticResource LinterColumnCheckBoxTemplate}" ItemsSource="{Binding Columns.Columns}" />
                            <Rectangle Margin="0,4" Style="{StaticResource LinterHorizontalDivider}" />
                            <Button
                                Command="{Binding Columns.ShowAllCommand}"
                                Content="{Binding ResetColumnsText}"
                                Style="{StaticResource LinterDialogButton}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <ToggleButton
                    x:Name="FiltersButton"
                    behaviors:HelpToolTip.Description="{Binding MoreFiltersDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding MoreFiltersTitle, Mode=OneWay}"
                    Content="{controls:Icon Kind=Filter}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarPopupToggleButton}" />
                <Popup
                    IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=FiltersButton}"
                    Style="{StaticResource LinterToolBarPopup}">
                    <Border Style="{StaticResource LinterPopupPanel}">
                        <StackPanel>
                            <ListBox
                                x:Name="DocumentFilterList"
                                behaviors:HelpToolTip.Description="{Binding DocumentDescription, Mode=OneWay}"
                                behaviors:HelpToolTip.Title="{Binding DocumentText, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.OpenedDocuments.Documents, Source={StaticResource rootProxy}}"
                                SelectedValue="{Binding TargetDocumentTitle}"
                                SelectedValuePath="Title"
                                Style="{StaticResource LinterRadioListBox}" />
                            <Rectangle Margin="0,4" Style="{StaticResource LinterHorizontalDivider}" />
                            <ItemsControl ItemTemplate="{StaticResource LinterFilterCheckBoxTemplate}" ItemsSource="{Binding SeverityFilters}" />
                            <Rectangle Margin="0,4" Style="{StaticResource LinterHorizontalDivider}" />
                            <ItemsControl ItemTemplate="{StaticResource LinterFilterCheckBoxTemplate}" ItemsSource="{Binding Filters}" />
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBox
                    behaviors:HelpToolTip.Description="{Binding SearchDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding SearchText, Mode=OneWay}"
                    controls:Hint.Text="{Binding SearchText}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterSearchTextBox}"
                    Text="{Binding SearchField, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarLabel}"
                    Text="{Binding ReportsText}" />
                <UIElement />
            </DockPanel>
            <Rectangle DockPanel.Dock="Top" Style="{StaticResource LinterHorizontalDivider}" />
            <!--  The fix and visualization columns stay frozen so row refreshes on a narrow pane never scroll them partially out of view.  -->
            <DataGrid
                x:Name="FindingsGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                composition:TableColumns.Source="{Binding Columns}"
                FrozenColumnCount="2"
                IsReadOnly="True"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding CollectionViewSource.View}"
                SelectedItem="{Binding SelectedReport, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                    <behaviors:DataGridRowNavigationBehavior ActivateCommand="{Binding ShowCurrentVisualizationCommand}" />
                    <behaviors:FirstMatchRowHighlightBehavior HighlightKey="InspectFinding" TargetCode="TOUR001" />
                </i:Interaction.Behaviors>
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource LinterDataGridRow}" TargetType="DataGridRow">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Fixes}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource LinterMenuItem}" TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Title}" />
                                            <Setter Property="Command" Value="{Binding FixCommand}" />
                                            <Setter Property="Icon" Value="{Binding Icon}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <composition:BindingProxy x:Key="proxy" DataContext="{Binding}" />
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn MinWidth="{StaticResource LinterGridIconColumnWidth}" MaxWidth="{StaticResource LinterGridIconColumnWidth}" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    behaviors:HelpToolTip.Description="{Binding DataContext.FixDescription, Source={StaticResource proxy}, Mode=OneWay}"
                                    behaviors:HelpToolTip.Title="{Binding DataContext.FixTitle, Source={StaticResource proxy}, Mode=OneWay}"
                                    Command="{Binding ShowPrimaryFixCommand}"
                                    Content="{controls:Icon Kind=Lightbulb}"
                                    Foreground="{DynamicResource LinterHighlightIconBrush}"
                                    Visibility="{Binding HasFixes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <i:Interaction.Behaviors>
                                        <behaviors:OpenContextMenuOnClickBehavior OpenOnClick="{Binding HasMultipleFixes}" />
                                    </i:Interaction.Behaviors>
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource LinterGridIconButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="behaviors:OnboardingHighlight.Key" Value="UnderstandFix" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding Fixes}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource LinterMenuItem}" TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Title}" />
                                                    <Setter Property="Command" Value="{Binding FixCommand}" />
                                                    <Setter Property="Icon" Value="{Binding Icon}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="{StaticResource LinterGridIconColumnWidth}" MaxWidth="{StaticResource LinterGridIconColumnWidth}" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    behaviors:HelpToolTip.Description="{Binding DataContext.ShowVisualizationDescription, Source={StaticResource proxy}, Mode=OneWay}"
                                    behaviors:HelpToolTip.Title="{Binding DataContext.ShowVisualizationText, Source={StaticResource proxy}, Mode=OneWay}"
                                    Command="{Binding DataContext.SelectAndShowPrimaryVisualizationCommand, Source={StaticResource proxy}}"
                                    CommandParameter="{Binding}"
                                    Content="{controls:Icon Kind=Eye}"
                                    IsEnabled="{Binding HasVisualizationPipelines}">
                                    <i:Interaction.Behaviors>
                                        <behaviors:OpenContextMenuOnClickBehavior OpenOnClick="{Binding HasMultipleVisualizationPipelines}" />
                                    </i:Interaction.Behaviors>
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource LinterGridIconButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveVisualization}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource LinterAccentBrush}" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="behaviors:OnboardingHighlight.Key" Value="ShowElement" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" ItemsSource="{Binding VisualizationPipelines}">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource LinterMenuItem}" TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Title}" />
                                                    <Setter Property="Command" Value="{Binding ShowFromMenuCommand}" />
                                                    <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridCodeColumnMinWidth}"
                        composition:TableColumns.Key="{x:Static models:TableColumnKeys.Code}"
                        Header="{Binding DataContext.CodeHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterSeverityCodeCellTextBox}" Text="{Binding Code}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="{StaticResource LinterStretchColumnMinWidth}"
                        composition:TableColumns.Key="{x:Static models:TableColumnKeys.Message}"
                        Header="{Binding DataContext.MessageHeader, Source={StaticResource proxy}}"
                        SortMemberPath="MessageText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <Style BasedOn="{StaticResource LinterReportHyperlink}" TargetType="Hyperlink" />
                                </DataTemplate.Resources>
                                <Grid>
                                    <messaging:ReportMessageView
                                        x:Name="FoldedMessage"
                                        VerticalAlignment="Center"
                                        ExpanderCommand="{Binding ExpandListCommand}"
                                        ExpanderToolTip="{Binding ExpandListToolTip}"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsObsolete="{Binding IsObsolete}"
                                        IsSelectionEnabled="True"
                                        LinkCommand="{Binding AccentElementCommand}"
                                        Parts="{Binding MessageParts}"
                                        ToolTipFormat="{Binding ShowElementToolTipFormat}"
                                        VerticalScrollBarVisibility="Disabled">
                                        <i:Interaction.Behaviors>
                                            <behaviors:PassMouseWheelToParentBehavior />
                                        </i:Interaction.Behaviors>
                                    </messaging:ReportMessageView>
                                    <Popup
                                        Closed="MessageListPopup_Closed"
                                        IsOpen="{Binding IsListExpanded, Mode=TwoWay}"
                                        Placement="Bottom"
                                        PlacementTarget="{Binding ElementName=FoldedMessage}"
                                        StaysOpen="False">
                                        <Border
                                            Width="420"
                                            Padding="8"
                                            Background="{DynamicResource LinterSurfaceBrush}"
                                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                                            BorderThickness="1">
                                            <messaging:ReportMessageView
                                                MaxHeight="240"
                                                HorizontalScrollBarVisibility="Disabled"
                                                IsObsolete="{Binding IsObsolete}"
                                                IsSelectionEnabled="True"
                                                LinkCommand="{Binding AccentElementCommand}"
                                                Parts="{Binding ExpandedListParts}"
                                                ToolTipFormat="{Binding ShowElementToolTipFormat}"
                                                VerticalScrollBarVisibility="Auto" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridDocumentColumnMinWidth}"
                        composition:TableColumns.Key="{x:Static models:TableColumnKeys.Document}"
                        Header="{Binding DataContext.DocumentHeader, Source={StaticResource proxy}}"
                        SortMemberPath="DocumentTitle">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterReadOnlyCellTextBox}" Text="{Binding DocumentTitle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridCreatedColumnMinWidth}"
                        composition:TableColumns.Key="{x:Static models:TableColumnKeys.Created}"
                        Header="{Binding DataContext.CreatedHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Created">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource LinterReadOnlyCellTextBox}" Text="{Binding CreatedText, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridTagsColumnMinWidth}"
                        composition:TableColumns.Key="{x:Static models:TableColumnKeys.Tags}"
                        SortMemberPath="TagsText"
                        Header="{Binding DataContext.TagsHeader, Source={StaticResource proxy}}">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource LinterDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="behaviors:HelpToolTip.Title" Value="{Binding DataContext.TagsHeader, Source={StaticResource proxy}, Mode=OneWay}" />
                                <Setter Property="behaviors:HelpToolTip.Description" Value="{Binding DataContext.TagsDescription, Source={StaticResource proxy}, Mode=OneWay}" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                behaviors:HelpToolTip.Description="{Binding DataContext.TagsDescription, Source={StaticResource proxy}, Mode=OneWay}"
                                                Command="{Binding DataContext.FilterByTagCommand, Source={StaticResource proxy}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource LinterTagChipButton}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn MinWidth="{StaticResource LinterGridIconColumnWidth}" MaxWidth="{StaticResource LinterGridIconColumnWidth}" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    behaviors:HelpToolTip.HelpCommand="{Binding OpenDocumentationCommand}"
                                    behaviors:HelpToolTip.Title="{Binding DataContext.OpenDocumentationText, Source={StaticResource proxy}, Mode=OneWay}"
                                    Command="{Binding OpenDocumentationCommand}"
                                    Content="{controls:Icon Kind=HelpCircleOutline}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource LinterGridIconButton}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="behaviors:OnboardingHighlight.Key" Value="OpenHelp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
