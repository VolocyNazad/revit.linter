<UserControl
    x:Class="Revit.Linter.DiagnosticListPresenter.Views.DiagnosticListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Revit.Linter.Core.Abstractions.Models;assembly=Revit.Linter.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:infrastructure="clr-namespace:Revit.Linter.DiagnosticListPresenter.Infrastructure"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewModels="clr-namespace:Revit.Linter.DiagnosticListPresenter.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:DiagnosticListViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Cyan"
                    SecondaryColor="DeepOrange" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider
                x:Key="DiagnosticSeverities"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="core:DiagnosticSeverity" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <viewModels:ServiceLocator x:Key="ServiceLocator" />
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <materialDesign:ColorZone
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <DockPanel>
            <DockPanel Height="45" DockPanel.Dock="Top">
                <ContentControl Content="{Binding RunDiagnosticView, Source={StaticResource ServiceLocator}}" />
                <Button
                    Content="{materialDesign:PackIcon Kind=FilterPlus,
                                                      Size=20}"
                    DockPanel.Dock="Right"
                    IsEnabled="False"
                    Style="{StaticResource MaterialDesignIconButton}" />
                <TextBox
                    Width="200"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    materialDesign:HintAssist.Hint="{Binding SearchText}"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Search"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding SearchField, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Text="{Binding DiagnosticsText}" />
                <UIElement />
            </DockPanel>
            <Rectangle
                Height="1"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Top"
                Fill="{DynamicResource MaterialDesignDivider}" />
            <DataGrid
                d:ItemsSource="{d:SampleData ItemCount=2}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding CollectionViewSource.View}">
                <DataGrid.Resources>
                    <infrastructure:BindingProxy x:Key="proxy" DataContext="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding CheckAllCommand}"
                            Header="{Binding CheckAllText}"
                            Icon="{materialDesign:PackIcon Kind=CheckboxMultipleOutline}" />
                        <MenuItem
                            Command="{Binding UncheckAllCommand}"
                            Header="{Binding UncheckAllText}"
                            Icon="{materialDesign:PackIcon Kind=CheckboxMultipleBlankOutline}" />
                        <Separator />
                        <MenuItem Command="{Binding CheckVisibleCommand}" Header="{Binding CheckVisibleText}" />
                        <MenuItem Command="{Binding UncheckVisibleCommand}" Header="{Binding UncheckVisibleText}" />
                        <Separator />
                        <MenuItem
                            Command="{Binding InvertAllCommand}"
                            Header="{Binding InvertAllText}"
                            Icon="{materialDesign:PackIcon Kind=SwapHorizontal}" />
                        <MenuItem Command="{Binding InvertVisibleCommand}" Header="{Binding InvertVisibleText}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <DockPanel>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            d:Text="Имя группы"
                                                            Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                            Text="{Binding Name}" />
                                                    </DockPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn
                        Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Header="{Binding DataContext.IsActiveHeader, Source={StaticResource proxy}}"
                        SortMemberPath="IsActive" />
                    <DataGridTemplateColumn Header="{Binding DataContext.CodeHeader, Source={StaticResource proxy}}" SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    IsReadOnlyCaretVisible="False">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Code, Mode=OneWay}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsObsolete}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="ToolTip" Value="{Binding ObsoleteDescription}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding DataContext.SeverityHeader, Source={StaticResource proxy}}" SortMemberPath="Severity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    IsEditable="True"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Source={StaticResource DiagnosticSeverities}}"
                                    SelectedItem="{Binding Severity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="1000"
                        Header="{Binding DataContext.DescriptionHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Description">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    VerticalAlignment="Center"
                                    BorderThickness="0"
                                    IsReadOnly="True"
                                    IsReadOnlyCaretVisible="False">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource MaterialDesignTextBox}" TargetType="TextBox">
                                            <Setter Property="Text" Value="{Binding Description, Mode=OneWay}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsObsolete}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="ToolTip" Value="{Binding ObsoleteDescription}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </materialDesign:ColorZone>
</UserControl>
