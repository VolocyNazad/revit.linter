<UserControl
    x:Class="Revit.Linter.DiagnosticListPresenter.Views.DiagnosticListView"
    x:Name="Root"
    behaviors:HelpToolTip.HelpCommand="{Binding OpenHelpCommand}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:core="clr-namespace:Revit.Linter.Core.Abstractions.Models;assembly=Revit.Linter.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:infrastructure="clr-namespace:Revit.Linter.DiagnosticListPresenter.Infrastructure"
    xmlns:controls="clr-namespace:Revit.Linter.ThemeManaging.Controls;assembly=Revit.Linter.ThemeManaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:composition="clr-namespace:Revit.Linter.Presentation;assembly=Revit.Linter.Presentation"
    xmlns:runDiagnostic="clr-namespace:Revit.Linter.RunDiagnosticPresenter.ViewModels;assembly=Revit.Linter.RunDiagnosticPresenter"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewModels="clr-namespace:Revit.Linter.DiagnosticListPresenter.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:DiagnosticListViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="600"
    Style="{DynamicResource LinterViewRoot}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider
                x:Key="DiagnosticSeverities"
                MethodName="GetValues"
                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="core:DiagnosticSeverity" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <infrastructure:DiagnosticSeverityConverter x:Key="DiagnosticSeverityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Style="{StaticResource LinterViewPanel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Style="{StaticResource LinterToolBarPanel}">
                <ContentControl Content="{composition:ViewLocatorExtension {x:Type runDiagnostic:RunDiagnosticViewModel}}" />
                <ToggleButton
                    x:Name="FiltersButton"
                    behaviors:HelpToolTip.Description="{Binding MoreFiltersDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding MoreFiltersTitle, Mode=OneWay}"
                    behaviors:OnboardingHighlight.Key="SearchAndFilters"
                    Content="{controls:Icon Kind=Filter}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarPopupToggleButton}" />
                <Popup
                    IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=FiltersButton}"
                    Style="{StaticResource LinterToolBarPopup}">
                    <Border Style="{StaticResource LinterPopupPanel}">
                        <ItemsControl ItemTemplate="{StaticResource LinterFilterCheckBoxTemplate}" ItemsSource="{Binding Filters}" />
                    </Border>
                </Popup>
                <TextBox
                    behaviors:HelpToolTip.Description="{Binding SearchDescription, Mode=OneWay}"
                    behaviors:HelpToolTip.Title="{Binding SearchText, Mode=OneWay}"
                    behaviors:OnboardingHighlight.Key="SearchAndFilters"
                    controls:Hint.Text="{Binding SearchText}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterSearchTextBox}"
                    Text="{Binding SearchField, UpdateSourceTrigger=LostFocus}" />
                <TextBlock
                    DockPanel.Dock="Right"
                    Style="{StaticResource LinterToolBarLabel}"
                    Text="{Binding DiagnosticsText}" />
                <UIElement />
            </DockPanel>
            <Rectangle DockPanel.Dock="Top" Style="{StaticResource LinterHorizontalDivider}" />
            <DataGrid
                d:ItemsSource="{d:SampleData ItemCount=2}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                ItemsSource="{Binding CollectionViewSource.View}">
                <DataGrid.Resources>
                    <composition:BindingProxy x:Key="proxy" DataContext="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding CheckAllDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding CheckAllText, Mode=OneWay}"
                            Command="{Binding CheckAllCommand}"
                            Header="{Binding CheckAllText}"
                            Icon="{controls:Icon Kind=CheckboxMultipleOutline}" />
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding UncheckAllDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding UncheckAllText, Mode=OneWay}"
                            Command="{Binding UncheckAllCommand}"
                            Header="{Binding UncheckAllText}"
                            Icon="{controls:Icon Kind=CheckboxMultipleBlankOutline}" />
                        <Separator />
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding CheckVisibleDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding CheckVisibleText, Mode=OneWay}"
                            Command="{Binding CheckVisibleCommand}"
                            Header="{Binding CheckVisibleText}" />
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding UncheckVisibleDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding UncheckVisibleText, Mode=OneWay}"
                            Command="{Binding UncheckVisibleCommand}"
                            Header="{Binding UncheckVisibleText}" />
                        <Separator />
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding InvertAllDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding InvertAllText, Mode=OneWay}"
                            Command="{Binding InvertAllCommand}"
                            Header="{Binding InvertAllText}"
                            Icon="{controls:Icon Kind=SwapHorizontal}" />
                        <MenuItem
                            behaviors:HelpToolTip.Description="{Binding InvertVisibleDescription, Mode=OneWay}"
                            behaviors:HelpToolTip.Title="{Binding InvertVisibleText, Mode=OneWay}"
                            Command="{Binding InvertVisibleCommand}"
                            Header="{Binding InvertVisibleText}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridToggleColumnMinWidth}"
                        Header="{Binding DataContext.IsActiveHeader, Source={StaticResource proxy}}"
                        SortMemberPath="IsActive">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource LinterDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                                <Setter Property="behaviors:HelpToolTip.Title" Value="{Binding DataContext.IsActiveHeader, Source={StaticResource proxy}, Mode=OneWay}" />
                                <Setter Property="behaviors:HelpToolTip.Description" Value="{Binding DataContext.IsActiveDescription, Source={StaticResource proxy}, Mode=OneWay}" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <CheckBox.Style>
                                        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Code}" Value="TOUR001">
                                                    <Setter Property="behaviors:OnboardingHighlight.Key" Value="SelectDiagnostic" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridExampleCodeColumnMinWidth}"
                        Header="{Binding DataContext.CodeHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Code">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource LinterObsoleteAwareCellTextBox}" Text="{Binding Code, Mode=OneWay}" />
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LinterSelectionBrush}"
                                        BorderBrush="{DynamicResource LinterAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Visibility="{Binding IsExample, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource LinterAccentBrush}"
                                            Text="{Binding DataContext.ExampleText, ElementName=Root, Mode=OneWay}" />
                                    </Border>
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource LinterSelectionBrush}"
                                        BorderBrush="{DynamicResource LinterAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Visibility="{Binding IsTour, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource LinterAccentBrush}"
                                            Text="{Binding DataContext.TourText, ElementName=Root, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="Auto"
                        MinWidth="{StaticResource LinterGridSeverityColumnMinWidth}"
                        Header="{Binding DataContext.SeverityHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Severity">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource LinterDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                                <Setter Property="behaviors:HelpToolTip.Title" Value="{Binding DataContext.SeverityHeader, Source={StaticResource proxy}, Mode=OneWay}" />
                                <Setter Property="behaviors:HelpToolTip.Description" Value="{Binding DataContext.SeverityDescription, Source={StaticResource proxy}, Mode=OneWay}" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding Source={StaticResource DiagnosticSeverities}}"
                                    SelectedItem="{Binding Severity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DiagnosticSeverityConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="{StaticResource LinterStretchColumnMinWidth}"
                        Header="{Binding DataContext.DescriptionHeader, Source={StaticResource proxy}}"
                        SortMemberPath="Description">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox
                                    Style="{StaticResource LinterObsoleteAwareCellTextBox}"
                                    Text="{Binding Description, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
