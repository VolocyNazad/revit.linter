<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">
	<PropertyGroup>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Revit.Linter.WelcomePresenter.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="VolocyNazad.Revit.Context" />
		<PackageReference Include="VolocyNazad.ValueStore" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Remove="ViewModels\Welcome*ViewModel*.resx" />
		<None Include="ViewModels\WelcomeViewModel.resx"><DependentUpon>WelcomeViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomeViewModel.ru.resx"><DependentUpon>WelcomeViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomeViewModel.resx" />
		<None Include="ViewModels\WelcomeIntroStepViewModel.resx"><DependentUpon>WelcomeIntroStepViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomeIntroStepViewModel.ru.resx"><DependentUpon>WelcomeIntroStepViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomeIntroStepViewModel.resx" />
		<None Include="ViewModels\WelcomeRulesStepViewModel.resx"><DependentUpon>WelcomeRulesStepViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomeRulesStepViewModel.ru.resx"><DependentUpon>WelcomeRulesStepViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomeRulesStepViewModel.resx" />
		<None Include="ViewModels\WelcomeExamplesStepViewModel.resx"><DependentUpon>WelcomeExamplesStepViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomeExamplesStepViewModel.ru.resx"><DependentUpon>WelcomeExamplesStepViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomeExamplesStepViewModel.resx" />
		<None Include="ViewModels\WelcomePracticalStepViewModel.resx"><DependentUpon>WelcomePracticalStepViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomePracticalStepViewModel.ru.resx"><DependentUpon>WelcomePracticalStepViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomePracticalStepViewModel.resx" />
		<None Include="ViewModels\WelcomeFinishStepViewModel.resx"><DependentUpon>WelcomeFinishStepViewModel.cs</DependentUpon></None>
		<None Include="ViewModels\WelcomeFinishStepViewModel.ru.resx"><DependentUpon>WelcomeFinishStepViewModel.cs</DependentUpon></None>
		<AdditionalFiles Include="ViewModels\WelcomeFinishStepViewModel.resx" />
		<ProjectReference Include="..\Revit.Linter.Localization.Generator\Revit.Linter.Localization.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<ItemGroup>
		<!-- The installed examples are the Wiki example files themselves, so the documentation and the product cannot drift apart. -->
		<EmbeddedResource Include="..\..\wiki\examples\configuration\diagnostics.config.yaml" LogicalName="Revit.Linter.WelcomePresenter.Examples.en.diagnostics.config.yaml" Link="Examples\en\diagnostics.config.yaml" />
		<EmbeddedResource Include="..\..\wiki\examples\configuration\ru\diagnostics.config.yaml" LogicalName="Revit.Linter.WelcomePresenter.Examples.ru.diagnostics.config.yaml" Link="Examples\ru\diagnostics.config.yaml" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Revit.Linter.Behaviors\Revit.Linter.Behaviors.csproj" />
		<ProjectReference Include="..\Revit.Linter.ConfigurationPath\Revit.Linter.ConfigurationPath.csproj" />
		<ProjectReference Include="..\Revit.Linter.Core\Revit.Linter.Core.csproj" />
		<ProjectReference Include="..\Revit.Linter.Localization\Revit.Linter.Localization.csproj" />
		<ProjectReference Include="..\Revit.Linter.OnboardingState\Revit.Linter.OnboardingState.csproj" />
		<ProjectReference Include="..\Revit.Linter.PracticalTourPresenter.Interactions\Revit.Linter.PracticalTourPresenter.Interactions.csproj" />
		<ProjectReference Include="..\Revit.Linter.ThemeManaging\Revit.Linter.ThemeManaging.csproj" />
	</ItemGroup>
</Project>

