		<EmbeddedResource Include="..\..\wiki\examples\configuration\practical-tour.config.yaml" LogicalName="Revit.Linter.WelcomePresenter.Examples.en.practical-tour.config.yaml" Link="Examples\en\practical-tour.config.yaml" />
		<EmbeddedResource Include="..\..\wiki\examples\configuration\ru\config.yaml" LogicalName="Revit.Linter.WelcomePresenter.Examples.ru.config.yaml" Link="Examples\ru\config.yaml" />
