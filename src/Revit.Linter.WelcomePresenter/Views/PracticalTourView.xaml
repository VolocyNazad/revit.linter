<UserControl
    x:Class="Revit.Linter.WelcomePresenter.Views.PracticalTourView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.WelcomePresenter.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    MinWidth="280"
    d:DesignHeight="580"
    d:DesignWidth="360"
    d:DataContext="{d:DesignInstance Type={x:Type designData:PracticalTourDesignData}, IsDesignTimeCreatable=True}"
    Style="{DynamicResource LinterViewRoot}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><theme:SharedThemeResources /></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource LinterViewPanel}">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock FontWeight="SemiBold" Style="{StaticResource LinterDialogTitleText}" Text="{Binding TitleText}" />
            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="StepBorder" Margin="0,0,0,2" Padding="6" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="StepTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="StepInstruction"
                                            Margin="0,4,0,0"
                                            Opacity="0.8"
                                            Text="{Binding Instruction}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="Status" Property="Text" Value="✓" />
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource LinterAccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                    <Setter TargetName="Status" Property="Text" Value="—" />
                                    <Setter TargetName="StepTitle" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="StepBorder" Property="Background" Value="{DynamicResource LinterSelectionBrush}" />
                                    <Setter TargetName="Status" Property="Text" Value="→" />
                                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource LinterAccentBrush}" />
                                    <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="StepInstruction" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Margin="0,6,0,0" Command="{Binding StopCommand}" Content="{Binding StopText}" Style="{StaticResource LinterDialogButton}" />
                <Button Margin="0,6,0,0" Command="{Binding RestartCommand}" Content="{Binding RestartText}" Style="{StaticResource LinterDialogButton}" />
                <Button Margin="0,6,0,0" Command="{Binding OptOutCommand}" Content="{Binding OptOutText}" Style="{StaticResource LinterDialogButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
