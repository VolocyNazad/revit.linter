<Window
    x:Class="Revit.Linter.WelcomePresenter.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.WelcomePresenter.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:views="clr-namespace:Revit.Linter.WelcomePresenter.Views"
    xmlns:viewModels="clr-namespace:Revit.Linter.WelcomePresenter.ViewModels"
    Title="{Binding WindowTitle}"
    Width="760"
    Height="600"
    d:DataContext="{d:DesignInstance Type={x:Type designData:WelcomeDesignData}, IsDesignTimeCreatable=True}"
    FocusManager.FocusedElement="{Binding ElementName=NextButton}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Style="{DynamicResource LinterViewRoot}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <DataTemplate x:Key="ImportantItemTemplate">
                <Grid Margin="4,2,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,9,0"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource LinterAccentBrush}"
                        Text="&#x2022;" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding}"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeIntroStepViewModel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding AboutText, Mode=OneWay}" />
                    <Border
                        Margin="0,4,0,16"
                        Padding="12"
                        Background="{DynamicResource LinterInputBackgroundBrush}"
                        BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding WorkflowText, Mode=OneWay}"
                            TextAlignment="Center" />
                    </Border>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource LinterParagraphText}"
                        Text="{Binding ImportantHeaderText, Mode=OneWay}" />
                    <StackPanel>
                        <ContentControl Content="{Binding TabInfo, Mode=OneWay}" ContentTemplate="{StaticResource ImportantItemTemplate}" />
                        <ContentControl Content="{Binding ParametersText, Mode=OneWay}" ContentTemplate="{StaticResource ImportantItemTemplate}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeRulesStepViewModel}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="12"
                            Background="{DynamicResource LinterInputBackgroundBrush}"
                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource LinterParagraphText}"
                                    Text="{Binding BuiltInTitleText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding BuiltInDescriptionText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="12"
                            Background="{DynamicResource LinterInputBackgroundBrush}"
                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource LinterParagraphText}"
                                    Text="{Binding UserTitleText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding UserDescriptionText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource LinterParagraphText}"
                        Text="{Binding RuleKindsTitleText, Mode=OneWay}" />
                    <StackPanel Margin="0,0,0,12">
                        <ContentControl Content="{Binding ElementRuleKindText, Mode=OneWay}" ContentTemplate="{StaticResource ImportantItemTemplate}" />
                        <ContentControl Content="{Binding CollisionRuleKindText, Mode=OneWay}" ContentTemplate="{StaticResource ImportantItemTemplate}" />
                        <ContentControl Content="{Binding ParameterRuleKindText, Mode=OneWay}" ContentTemplate="{StaticResource ImportantItemTemplate}" />
                    </StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource LinterParagraphText}"
                        Text="{Binding VisualizerTitleText, Mode=OneWay}" />
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding ElementPreviewTitleText, Mode=OneWay}" />
                        <views:YamlPreviewView
                            Height="116"
                            Padding="12"
                            Background="{DynamicResource LinterInputBackgroundBrush}"
                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                            BorderThickness="1"
                            Text="{Binding RulePreviewText, Mode=OneWay}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding CodeExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource LinterParagraphText}" Text="{Binding DescriptionExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource LinterParagraphText}" Text="{Binding SeverityExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding TakeExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding CheckExplanationText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding CollisionPreviewTitleText, Mode=OneWay}" />
                        <views:YamlPreviewView
                            Height="132"
                            Padding="12"
                            Background="{DynamicResource LinterInputBackgroundBrush}"
                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                            BorderThickness="1"
                            Text="{Binding CollisionRulePreviewText, Mode=OneWay}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding AndTakeExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource LinterParagraphText}" Text="{Binding GroupByExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding IntersectionExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding CollisionTakeExplanationText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding ProjectParameterPreviewTitleText, Mode=OneWay}" />
                        <views:YamlPreviewView
                            Height="164"
                            Padding="12"
                            Background="{DynamicResource LinterInputBackgroundBrush}"
                            BorderBrush="{DynamicResource LinterStrongBorderBrush}"
                            BorderThickness="1"
                            Text="{Binding ProjectParameterRulePreviewText, Mode=OneWay}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding ParametersExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource LinterParagraphText}" Text="{Binding GuidExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource LinterParagraphText}" Text="{Binding GroupExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding CategoriesExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding IsInstanceExplanationText, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LinterParagraphText}" Text="{Binding AllowVaryExplanationText, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeExamplesStepViewModel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding IntroText, Mode=OneWay}" />
                    <CheckBox
                        Margin="0,0,0,8"
                        Content="{Binding MepText, Mode=OneWay}"
                        IsChecked="{Binding IsMepSelected}" />
                    <CheckBox
                        Margin="0,0,0,8"
                        Content="{Binding ArchitectureText, Mode=OneWay}"
                        IsChecked="{Binding IsArchitectureSelected}" />
                    <CheckBox
                        Margin="0,0,0,12"
                        Content="{Binding StructureText, Mode=OneWay}"
                        IsChecked="{Binding IsStructureSelected}" />
                    <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding ContentsText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding TargetInfo, Mode=OneWay}" />
                    <Button
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        Command="{Binding InstallCommand}"
                        Content="{Binding InstallButtonText, Mode=OneWay}"
                        Style="{StaticResource LinterDialogButton}" />
                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Background="{DynamicResource LinterSelectionBrush}"
                        BorderBrush="{DynamicResource LinterAccentBrush}"
                        BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0"
                                                        To="1"
                                                        Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource LinterAccentBrush}"
                            Text="{Binding InstallationFeedback, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Style="{StaticResource LinterStatusText}" Text="{Binding StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomePracticalStepViewModel}">
                <StackPanel>
                    <CheckBox
                        Margin="0,0,0,8"
                        Content="{Binding StartPracticalTourText, Mode=OneWay}"
                        IsChecked="{Binding StartPracticalTour}" />
                    <StackPanel Visibility="{Binding CanUseTutorialSample, Converter={StaticResource BooleanToVisibility}}">
                        <CheckBox
                            Margin="0,0,0,8"
                            Content="{Binding UseTutorialSampleText, Mode=OneWay}"
                            IsEnabled="{Binding StartPracticalTour}"
                            IsChecked="{Binding UseTutorialSample}" />
                        <ComboBox
                            Margin="0,0,0,8"
                            DisplayMemberPath="FileName"
                            IsEnabled="{Binding CanSelectTutorialSample}"
                            ItemsSource="{Binding TutorialSamples}"
                            SelectedItem="{Binding SelectedTutorialSample}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource LinterStatusText}"
                        Text="{Binding TutorialSampleStatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontWeight="SemiBold"
                        Style="{StaticResource LinterStatusText}"
                        Text="{Binding NextActionText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetPracticalTourCommand}"
                        Content="{Binding ResetPracticalTourText, Mode=OneWay}"
                        Style="{StaticResource LinterDialogButton}" />
                    <TextBlock
                        Foreground="{DynamicResource LinterAccentBrush}"
                        Text="{Binding Note, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource LinterStatusText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeFinishStepViewModel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LinterParagraphText}" Text="{Binding ReopenInfo, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding OpenQuickStartCommand}"
                            Content="{Binding QuickStartText, Mode=OneWay}"
                            Style="{StaticResource LinterDialogButton}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding OpenDocumentationCommand}"
                            Content="{Binding DocumentationText, Mode=OneWay}"
                            Style="{StaticResource LinterDialogButton}" />
                        <Button
                            Margin="8,0,0,0"
                            Command="{Binding OpenSupportCommand}"
                            Content="{Binding SupportText, Mode=OneWay}"
                            Style="{StaticResource LinterDialogButton}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!--  Enter presses the default button (Next, or Finish on the last step) and Esc the cancel button.  -->
    <Window.InputBindings>
        <KeyBinding
            Key="Left"
            Command="{Binding GoBackCommand}"
            Modifiers="Alt" />
        <KeyBinding
            Key="Right"
            Command="{Binding GoNextCommand}"
            Modifiers="Alt" />
        <KeyBinding Key="PageUp" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding GoNextCommand}" />
    </Window.InputBindings>
    <Border Style="{StaticResource LinterWindowPanel}">
        <Grid Style="{StaticResource LinterDialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Opacity="0.6"
                    Text="{Binding Progress, Mode=OneWay}" />
                <TextBlock Style="{StaticResource LinterDialogTitleText}" Text="{Binding WindowTitle, Mode=OneWay}" />
            </DockPanel>
            <ItemsControl
                Grid.Row="1"
                Margin="0,12,0,0"
                Focusable="False"
                ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="StepArrow"
                                Margin="10,0,10,0"
                                Opacity="0.5"
                                Text="&#x2192;" />
                            <Button
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Focusable="False">
                                <TextBlock x:Name="StepLabel" Opacity="0.5">
                                    <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <!-- The arrow separates a step from the previous one, so the first step has none. -->
                            <DataTrigger Binding="{Binding Number}" Value="1">
                                <Setter TargetName="StepArrow" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="StepLabel" Property="Opacity" Value="1" />
                                <Setter TargetName="StepLabel" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border
                Grid.Row="2"
                Margin="0,16,0,16"
                Style="{StaticResource LinterRemarkBorder}">
                <TextBlock Style="{StaticResource LinterRemarkText}" Text="{Binding CurrentStep.Caption, Mode=OneWay}" />
            </Border>
            <ScrollViewer
                Grid.Row="3"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{Binding CurrentStep}"
                    d:ContentTemplate="{StaticResource {x:Type viewModels:WelcomeRulesStepViewModel}}"
                    Focusable="False" />
            </ScrollViewer>
            <DockPanel Grid.Row="4" Margin="0,16,0,0">
                <Button
                    Content="{Binding CloseButtonText, Mode=OneWay}"
                    DockPanel.Dock="Left"
                    IsCancel="True"
                    Style="{StaticResource LinterDialogButton}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Command="{Binding GoBackCommand}"
                        Content="{Binding BackButtonText, Mode=OneWay}"
                        Style="{StaticResource LinterDialogButton}" />
                    <Button
                        x:Name="NextButton"
                        Margin="8,0,0,0"
                        Command="{Binding GoNextCommand}"
                        Content="{Binding NextButtonText, Mode=OneWay}"
                        IsDefault="{Binding HasNextStep}"
                        Style="{StaticResource LinterDialogButton}"
                        Visibility="{Binding HasNextStep, Converter={StaticResource BooleanToVisibility}}" />
                    <Button
                        Margin="8,0,0,0"
                        Click="FinishButton_Click"
                        Content="{Binding FinishButtonText, Mode=OneWay}"
                        IsDefault="{Binding IsLastStep}"
                        Style="{StaticResource LinterDialogButton}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
