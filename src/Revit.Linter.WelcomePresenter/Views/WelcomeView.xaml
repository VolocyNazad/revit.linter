<Window
    x:Class="Revit.Linter.WelcomePresenter.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:Revit.Linter.WelcomePresenter.DesignData"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:behaviors="clr-namespace:Revit.Linter.Behaviors;assembly=Revit.Linter.Behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Revit.Linter.ThemeManaging.Resources;assembly=Revit.Linter.ThemeManaging"
    xmlns:viewModels="clr-namespace:Revit.Linter.WelcomePresenter.ViewModels"
    Title="{Binding WindowTitle}"
    Width="760"
    Height="600"
    d:DataContext="{d:DesignInstance Type={x:Type designData:WelcomeDesignData}, IsDesignTimeCreatable=True}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Style="{DynamicResource LinterViewRoot}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:SharedThemeResources />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <!--  A row of the main-page contents: a whole-width flat button with a hover surface.  -->
            <Style
                x:Key="WelcomeContentsButton"
                BasedOn="{StaticResource LinterStepButton}"
                TargetType="{x:Type Button}">
                <Setter Property="BorderBrush" Value="{DynamicResource LinterBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource LinterHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="WelcomeIntroStepTemplate">
                <StackPanel>
                    <TextBlock
                        Margin="0,16,0,8"
                        Style="{StaticResource LinterParagraphText}"
                        Text="{Binding AboutText, Mode=OneWay}" />
                    <ItemsControl
                        Margin="0,0,0,12"
                        Focusable="False"
                        ItemsSource="{Binding Contents, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding CommandParameter}"
                                    Style="{StaticResource WelcomeContentsButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{DynamicResource LinterSecondaryForegroundBrush}"
                                                Text="{Binding Summary, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource LinterAccentBrush}"
                                            Text="{Binding ActionGlyph, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeIntroStepViewModel}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WelcomeIntroStepTemplate}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomeExamplesStepViewModel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding ExamplesHeaderText, Mode=OneWay}"
                            ToolTip="{Binding ContentsText, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Style="{StaticResource LinterParagraphText}"
                            Text="{Binding AdskChecksHeaderText, Mode=OneWay}"
                            ToolTip="{Binding AdskChecksIntroText, Mode=OneWay}" />
                        <StackPanel Grid.Row="1">
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding MepText, Mode=OneWay}"
                                IsChecked="{Binding IsMepSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding ArchitectureText, Mode=OneWay}"
                                IsChecked="{Binding IsArchitectureSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding StructureText, Mode=OneWay}"
                                IsChecked="{Binding IsStructureSelected}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckArchitectureText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckArchitectureSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckWaterSupplyText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckWaterSupplySelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckReinforcedConcreteText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckReinforcedConcreteSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckSteelStructuresText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckSteelStructuresSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckHvacText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckHvacSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckLowCurrentText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckLowCurrentSelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckTechnologyText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckTechnologySelected}" />
                            <CheckBox
                                Margin="0,0,0,8"
                                Content="{Binding AdskCheckElectricalText, Mode=OneWay}"
                                IsChecked="{Binding IsCheckElectricalSelected}" />
                        </StackPanel>
                    </Grid>
                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Background="{DynamicResource LinterSelectionBrush}"
                        BorderBrush="{DynamicResource LinterAccentBrush}"
                        BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0"
                                                        To="1"
                                                        Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource LinterAccentBrush}"
                            Text="{Binding InstallationFeedback, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Style="{StaticResource LinterStatusText}" Text="{Binding StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WelcomePracticalStepViewModel}">
                <StackPanel>
                    <CheckBox
                        Margin="0,0,0,8"
                        Content="{Binding StartPracticalTourText, Mode=OneWay}"
                        IsChecked="{Binding StartPracticalTour}" />
                    <StackPanel
                        Margin="20,0,0,0"
                        Visibility="{Binding CanUseTutorialSample, Converter={StaticResource BooleanToVisibility}}">
                        <CheckBox
                            Margin="0,0,0,8"
                            Content="{Binding UseTutorialSampleText, Mode=OneWay}"
                            IsEnabled="{Binding StartPracticalTour}"
                            IsChecked="{Binding UseTutorialSample}" />
                        <ComboBox
                            Margin="0,0,0,8"
                            DisplayMemberPath="FileName"
                            IsEnabled="{Binding CanSelectTutorialSample}"
                            ItemsSource="{Binding TutorialSamples}"
                            SelectedItem="{Binding SelectedTutorialSample}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource LinterStatusText}"
                        Text="{Binding TutorialSampleStatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,12"
                        FontWeight="SemiBold"
                        Style="{StaticResource LinterStatusText}"
                        Text="{Binding NextActionText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetPracticalTourCommand}"
                        Content="{Binding ResetPracticalTourText, Mode=OneWay}"
                        Style="{StaticResource LinterDialogButton}" />
                    <TextBlock
                        Foreground="{DynamicResource LinterAccentBrush}"
                        Text="{Binding Note, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource LinterStatusText}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!--  Enter presses the start-tour button on the practical step and Esc the cancel button.  -->
    <i:Interaction.Behaviors>
        <behaviors:WindowDialogResultBehavior DialogResult="{Binding DialogResult}" />
    </i:Interaction.Behaviors>
    <Window.InputBindings>
        <KeyBinding
            Key="Left"
            Command="{Binding GoBackCommand}"
            Modifiers="Alt" />
        <KeyBinding Key="PageUp" Command="{Binding GoBackCommand}" />
    </Window.InputBindings>
    <Border Style="{StaticResource LinterWindowPanel}">
        <Grid Style="{StaticResource LinterDialogContent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Opacity="0.6"
                    Text="{Binding VersionText, Mode=OneWay}" />
                <Button
                    MinWidth="28"
                    MinHeight="28"
                    Margin="0,0,8,0"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding BackButtonText, Mode=OneWay}"
                    Command="{Binding GoBackCommand}"
                    Content="&#x2190;"
                    DockPanel.Dock="Left"
                    Focusable="False"
                    FontSize="{StaticResource LinterTitleFontSize}"
                    Style="{StaticResource LinterStepButton}"
                    ToolTip="{Binding BackButtonText, Mode=OneWay}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource LinterDialogTitleText}"
                    Text="{Binding CurrentStep.Title, Mode=OneWay}" />
            </DockPanel>
            <Border
                Grid.Row="1"
                Margin="0,16,0,16"
                Style="{StaticResource LinterRemarkBorder}"
                Visibility="{Binding CurrentStep.HasCaption, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Style="{StaticResource LinterRemarkText}" Text="{Binding CurrentStep.Caption, Mode=OneWay}" />
            </Border>
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    Content="{Binding CurrentStep}"
                    d:ContentTemplate="{StaticResource WelcomeIntroStepTemplate}"
                    Focusable="False" />
            </ScrollViewer>
            <DockPanel Grid.Row="3" Margin="0,16,0,4">
                <Button
                    MinHeight="28"
                    Margin="-8,0,0,0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    Content="{Binding CloseButtonText, Mode=OneWay}"
                    DockPanel.Dock="Left"
                    IsCancel="True"
                    Style="{StaticResource LinterStepButton}" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding PrimaryActionCommand}"
                    Content="{Binding CurrentStep.PrimaryActionText, Mode=OneWay}"
                    IsDefault="{Binding CurrentStep.HasPrimaryAction}"
                    Style="{StaticResource LinterDialogButton}"
                    ToolTip="{Binding CurrentStep.PrimaryActionToolTip, Mode=OneWay}"
                    Visibility="{Binding CurrentStep.HasPrimaryAction, Converter={StaticResource BooleanToVisibility}}">
                    <Button.CommandParameter>
                        <system:Boolean>True</system:Boolean>
                    </Button.CommandParameter>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</Window>
